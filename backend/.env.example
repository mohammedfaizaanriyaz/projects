# MariaDB TCP connection; provision this account manually before starting.
DB_HOST=127.0.0.1
DB_USER=vyra_app
DB_PASSWORD=
DB_NAME=fullstack_demo
DB_PORT=3306
DB_CONNECTION_LIMIT=5
DB_SSL=false
# Optional absolute path to the database provider's CA certificate.
# DB_SSL_CA=/absolute/path/to/database-ca.pem

HOST=127.0.0.1
PORT=5000
TRUST_PROXY_HOPS=0

# Generate a new random value; do not reuse a password or a committed example.
JWT_SECRET=

NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Obtain your own key from USDA FoodData Central; keep it server-side.
USDA_API_KEY=
